#!/usr/bin/env bash
# skill-x — one guided entry point for the whole installation lifecycle.
#
#   skill-x init       select agents, build, sync, verify
#   skill-x install    apply the recorded selection (repairs a moved checkout)
#   skill-x sync       re-link the deployed skills without rebuilding
#   skill-x status     what is installed, and whether it is current
#   skill-x doctor     health of every managed path
#   skill-x update     fetch, preview, fast-forward, rebuild, sync, verify
#   skill-x uninstall  remove only what this installation manages
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=bin/lib/common.sh
. "$ROOT/bin/lib/common.sh"

SX_ROOT=$ROOT
SX_ID=$(sx_install_id "$ROOT")
MANIFEST=$(sx_manifest_path "$SX_ID")
TARGETS_CONF="$ROOT/bin/targets/targets.conf"
TARGETS_DIR="$ROOT/bin/targets"
[[ -f "$TARGETS_CONF" ]] || sx_die "missing target registry: $TARGETS_CONF"
# shellcheck source=bin/targets/targets.conf
source "$TARGETS_CONF"
SOURCE="$ROOT/$CANONICAL_DEST"
COMMAND_SOURCE=""
for target_entry in "${TRANSFORMED_TARGETS[@]}"; do
  if [[ ${target_entry%%:*} == opencode-v1-commands ]]; then
    COMMAND_SOURCE="$ROOT/${target_entry##*:}"
  fi
done
SX_TMP=$(mktemp -d "${TMPDIR:-/tmp}/skill-x-cli.XXXXXX")
trap 'rm -rf "$SX_TMP"' EXIT

usage() {
  cat <<'EOF'
Usage: skill-x <command> [options]

Commands:
  init [--agents claude,codex,opencode] [--yes]
                        Select agents, build, synchronize and verify.
  install [--agents ...]
                        Re-apply the recorded selection. Idempotent; also the
                        repair command after moving the checkout.
  sync [--agents ...]   Re-link deployed skills without rebuilding.
  status [--json] [--no-fetch]
                        Installation, agents, managed paths and update state.
  doctor [--strict] [--json]
                        Health of every managed path. --strict exits non-zero
                        when anything is missing, stale or foreign.
  update [--check] [--yes]
                        Fetch the tracked upstream, preview the change, and
                        fast-forward. Never updates silently.
  uninstall [--agents ...] [--remove-checkout] [--yes]
                        Remove only entries this installation manages.
  help                  Show this message.

Environment:
  SKILL_X_AGENTS               default agent selection
  SKILL_X_OPENCODE_VERSION     auto|v1|v2 (OpenCode command shim behaviour)
  SKILL_X_CODEX_COMPAT         1 (default) also syncs the ~/.codex/skills path
  SKILL_X_STATE_HOME           base for per-installation state
  SKILL_X_STATE_DIR            pin one state directory (legacy layout)
  SKILL_X_DISABLE_UPDATE_CHECK 1 disables the invocation-time update check
EOF
}

# ---------------------------------------------------------------------------
# Selection
# ---------------------------------------------------------------------------

detected_agents() {
  local agent out=()
  for agent in "${SKILL_X_ALL_AGENTS[@]}"; do
    [[ -n "$(sx_agent_version_cached "$agent")" ]] && out+=("$agent")
  done
  printf '%s\n' "${out[*]+"${out[*]}"}"
}

manifest_agents() {
  local agents
  agents=$(sx_manifest_array "$MANIFEST" agents | tr '\n' ' ')
  printf '%s\n' "${agents% }"
}

# Resolve the agent selection for install/sync/uninstall.
#   $1 explicit --agents value (may be empty)
#   $2 "remember" to fall back to the recorded selection, "fresh" to skip it
#   $3 "prompt" to offer an interactive confirmation
resolve_agents() {
  local explicit=$1 remember=$2 interactive=$3 agents=""

  if [[ -n "$explicit" ]]; then
    sx_parse_agents "$explicit"
    return
  fi
  if [[ -n "${SKILL_X_AGENTS:-}" ]]; then
    sx_parse_agents "$SKILL_X_AGENTS"
    return
  fi
  if [[ "$remember" == remember ]]; then
    agents=$(manifest_agents)
  fi
  if [[ -z "$agents" ]]; then
    agents=$(detected_agents)
    if [[ -z "$agents" ]]; then
      # A container or a fresh machine often has no agent on PATH yet. Refusing
      # to install there would be worse than installing everything and saying so.
      sx_warn "no agent executables detected; selecting all of them (${SKILL_X_ALL_AGENTS[*]})"
      agents="${SKILL_X_ALL_AGENTS[*]}"
    fi
  fi

  if [[ "$interactive" == prompt && -t 0 && -t 1 ]]; then
    local reply
    printf 'Install skill-x for: %s\n' "$agents"
    printf 'Press Enter to accept, or type a comma-separated list (%s): ' \
      "$(IFS=,; echo "${SKILL_X_ALL_AGENTS[*]}")"
    read -r reply || reply=""
    [[ -n "$reply" ]] && agents=$(sx_parse_agents "$reply")
  fi

  sx_parse_agents "$agents"
}

opencode_mode() { "$ROOT/bin/opencode-version.sh"; }

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

# Print the target previously recorded for a managed symlink path. Presence in
# the manifest is the ownership proof; a matching name or target prefix alone is
# never enough to claim an existing path.
manifest_expected_target() {
  local wanted=$1 agent kind path target
  [[ -f "$MANIFEST" ]] || return 1
  while IFS=$'\t' read -r agent kind path target; do
    if [[ "$kind" == symlink && "$path" == "$wanted" ]]; then
      printf '%s\n' "$target"
      return 0
    fi
  done < <(sx_manifest_entries "$MANIFEST")
  return 1
}

link_or_warn() {
  local target=$1 link=$2 linked previous=""
  if [[ -L "$link" ]]; then
    linked=$(readlink "$link")
    if previous=$(manifest_expected_target "$link"); then
      if [[ "$linked" == "$previous" ]]; then
        [[ "$linked" == "$target" ]] || ln -sfn "$target" "$link"
      elif [[ "$linked" != "$target" ]]; then
        echo "WARNING: preserving foreign symlink: $link -> $linked" >&2
      fi
      # Keep the path in the new manifest even when it became foreign so doctor
      # can continue to diagnose it and uninstall will continue to preserve it.
      return 0
    fi
    echo "WARNING: preserving unowned symlink: $link -> $linked" >&2
    return 1
  elif [[ -e "$link" ]]; then
    if manifest_expected_target "$link" >/dev/null; then
      echo "WARNING: preserving foreign path that replaced a managed symlink: $link" >&2
      return 0
    fi
    echo "WARNING: skipping unowned non-symlink path: $link" >&2
    return 1
  else
    ln -s "$target" "$link"
  fi
}

# Remove command files this installation generated. Symlink ownership comes
# only from the manifest; regular pinned copies use the managed marker.
remove_managed_commands() {
  local dir=$1 keep_live=$2 path linked previous
  [[ -d "$dir" ]] || return 0
  while IFS= read -r -d '' path; do
    if [[ -L "$path" ]]; then
      linked=$(readlink "$path")
      previous=$(manifest_expected_target "$path" 2>/dev/null || true)
      [[ -n "$previous" && "$linked" == "$previous" ]] || continue
      if [[ "$keep_live" == keep-live && -f "$linked" ]]; then continue; fi
    elif [[ -f "$path" ]]; then
      [[ "$keep_live" == keep-live ]] && continue
      grep -q "$SKILL_X_MANAGED_MARKER" "$path" 2>/dev/null || continue
    else
      continue
    fi
    rm -f "$path"
    echo "Removed OpenCode command link: $path" >&2
  done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -type l -o -type f \) -print0)
}

# Synchronize the selected agents, append every managed entry to $2 as TSV, and
# print the resolved OpenCode mode. Progress and warnings go to stderr.
sync_agents() {
  local agents=$1 entries_out=$2
  [[ -d "$SOURCE" ]] || sx_die "no built skills in $SOURCE; run bin/build.sh first"

  local agent consumer target link skill name linked mode entry adapter artifact script previous
  : > "$entries_out"

  for entry in "${CANONICAL_CONSUMERS[@]}"; do
    consumer=${entry%%:*}
    target=${entry##*:}
    case "$consumer" in
      claude-code) agent=claude; sx_contains claude $agents || continue ;;
      codex-defensive) agent=codex; sx_contains codex $agents || continue ;;
      codex)
        agent=codex
        sx_contains codex $agents || continue
        [[ "${SKILL_X_CODEX_COMPAT:-1}" == 0 ]] && continue
        ;;
      opencode-v2) agent=opencode; sx_contains opencode $agents || continue ;;
      *) agent=$consumer ;;
    esac
    target=${target/#~/$HOME}
    mkdir -p "$target"
    while IFS= read -r -d '' skill; do
      name=$(basename "$skill")
      link="$target/$name"
      link_or_warn "$skill" "$link" || continue
      printf '%s\t%s\t%s\t%s\n' "$agent" symlink "$link" "$skill" >> "$entries_out"
    done < <(find "$SOURCE" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

    # Remove a stale canonical link only when the prior manifest still proves
    # this exact symlink was ours. Foreign links are never inferred from target
    # prefixes, even when they point into this checkout.
    while IFS= read -r -d '' link; do
      linked=$(readlink "$link")
      if [[ "$linked" == "$SOURCE"/* && ! -d "$linked" ]]; then
        previous=$(manifest_expected_target "$link" 2>/dev/null || true)
        if [[ -n "$previous" && "$linked" == "$previous" ]]; then
          rm "$link"
          echo "Removed stale link: $link" >&2
        else
          echo "WARNING: preserving foreign stale symlink: $link -> $linked" >&2
        fi
      fi
    done < <(find "$target" -mindepth 1 -maxdepth 1 -type l -print0)
  done

  mode=$(opencode_mode)
  local commands_dir
  commands_dir=$(sx_opencode_commands_dir)
  if sx_contains opencode $agents && [[ "$mode" == v1 ]]; then
    [[ -n "$COMMAND_SOURCE" ]] || sx_die 'OpenCode v1 adapter is not registered'
    [[ -d "$COMMAND_SOURCE" ]] || sx_die "no built command shims in $COMMAND_SOURCE; run bin/build.sh first"
    mkdir -p "$commands_dir"
    while IFS= read -r -d '' skill; do
      name=$(basename "$skill")
      link="$commands_dir/$name"
      # A pinned/image install may have left a managed regular-file shim in
      # this HOME. Convert only files carrying our marker; user-owned command
      # files still go through link_or_warn and are preserved.
      if [[ ! -L "$link" && -f "$link" ]] && grep -q "$SKILL_X_MANAGED_MARKER" "$link" 2>/dev/null; then
        rm -f "$link"
      fi
      link_or_warn "$skill" "$link" || continue
      printf '%s\t%s\t%s\t%s\n' opencode symlink "$link" "$skill" >> "$entries_out"
    done < <(find "$COMMAND_SOURCE" -mindepth 1 -maxdepth 1 -type f -name '*.md' -print0 | sort -z)
    remove_managed_commands "$commands_dir" keep-live
  else
    remove_managed_commands "$commands_dir" remove-all
  fi

  # Any additional transformed target owns its own sync behavior. OpenCode is
  # handled above so its links can be recorded in the installation manifest.
  for entry in "${TRANSFORMED_TARGETS[@]}"; do
    adapter=${entry%%:*}
    [[ "$adapter" == opencode-v1-commands ]] && continue
    artifact=${entry##*:}
    script="$TARGETS_DIR/$adapter.sh"
    [[ -f "$script" ]] || continue
    "$script" sync "$ROOT/$artifact" >&2
  done
  printf '%s\n' "$mode"
}

# Drop entries the previous manifest recorded that the new selection no longer
# owns — deselected agents, renamed skills, a v1→v2 OpenCode switch.
prune_unmanaged() {
  local entries_out=$1 agent kind path target
  [[ -f "$MANIFEST" ]] || return 0
  while IFS=$'\t' read -r agent kind path target; do
    [[ -n "$path" ]] || continue
    if cut -f3 "$entries_out" | grep -qxF "$path"; then continue; fi
    if [[ -L "$path" && "$(readlink "$path")" == "$target" ]]; then
      rm -f "$path"
      echo "Removed managed link: $path" >&2
    fi
  done < <(sx_manifest_entries "$MANIFEST")
}

record_manifest() {
  local agents=$1 mode=$2 entries=$3
  SX_AGENTS=$agents
  SX_OPENCODE_MODE=$mode
  SX_COMMIT=$(sx_git_commit "$ROOT")
  SX_REPO_URL=$(sx_git_remote_url "$ROOT")
  SX_SKILLS=$(sx_skill_names "$ROOT" "$SOURCE")
  sx_write_manifest "$MANIFEST" "$entries"
}

print_invocation() {
  local agents=$1 agent
  echo 'Explicit invocation'
  for agent in $agents; do
    printf '  %-9s %s\n' "$agent" "$(sx_invocation_syntax "$agent")"
  done
}

# ---------------------------------------------------------------------------
# Entry health
# ---------------------------------------------------------------------------

# status<TAB>agent<TAB>path<TAB>detail for every recorded entry.
check_entries() {
  local agent kind path target
  while IFS=$'\t' read -r agent kind path target; do
    [[ -n "$path" ]] || continue
    if [[ -L "$path" ]]; then
      local linked
      linked=$(readlink "$path")
      if [[ "$linked" != "$target" ]]; then
        printf 'foreign\t%s\t%s\t%s\n' "$agent" "$path" "$linked"
      elif [[ ! -e "$linked" ]]; then
        printf 'stale\t%s\t%s\t%s\n' "$agent" "$path" "$linked"
      else
        printf 'ok\t%s\t%s\t%s\n' "$agent" "$path" "$linked"
      fi
    elif [[ -e "$path" ]]; then
      if [[ "$kind" == copy ]]; then
        printf 'ok\t%s\t%s\t%s\n' "$agent" "$path" copy
      else
        printf 'foreign\t%s\t%s\t%s\n' "$agent" "$path" 'not a symlink'
      fi
    else
      printf 'missing\t%s\t%s\t%s\n' "$agent" "$path" "$target"
    fi
  done < <(sx_manifest_entries "$MANIFEST")
}

# Installations recorded in this HOME whose checkout has disappeared.
orphaned_installations() {
  local manifest id path
  while IFS= read -r manifest; do
    id=$(sx_manifest_scalar "$manifest" installation_id)
    path=$(sx_manifest_scalar "$manifest" checkout_path)
    [[ "$id" == "$SX_ID" ]] && continue
    [[ -z "$path" || -d "$path" ]] && continue
    printf '%s\t%s\n' "$id" "$path"
  done < <(sx_all_manifests)
}

recorded_checkout() { sx_manifest_scalar "$MANIFEST" checkout_path; }

# ---------------------------------------------------------------------------
# Git state
# ---------------------------------------------------------------------------

# Sets GIT_STATE, GIT_AHEAD, GIT_BEHIND, GIT_UPSTREAM, GIT_DIRTY, GIT_REASON.
compute_git_state() {
  local do_fetch=$1
  GIT_STATE=unreachable
  GIT_AHEAD=0
  GIT_BEHIND=0
  GIT_UPSTREAM=""
  GIT_REMOTE=""
  GIT_REMOTE_BRANCH=""
  GIT_DIRTY=0
  GIT_REASON=""

  if ! sx_is_git_repo "$ROOT"; then
    GIT_REASON='not a git checkout (pinned copy?)'
    return 0
  fi
  sx_git_dirty "$ROOT" && GIT_DIRTY=1

  local parts
  parts=$(sx_git_upstream_parts "$ROOT")
  if [[ -z "$parts" ]]; then
    GIT_REASON='no tracked upstream branch'
    return 0
  fi
  IFS=$'\t' read -r GIT_REMOTE GIT_REMOTE_BRANCH GIT_UPSTREAM <<< "$parts"

  if [[ "$do_fetch" == fetch ]]; then
    # Comparing local HEAD with a stale remote-tracking ref is exactly how an
    # installation stays silently behind, so refresh it before deciding.
    if ! git -C "$ROOT" fetch --quiet "$GIT_REMOTE" "$GIT_REMOTE_BRANCH" 2>/dev/null; then
      GIT_REASON='could not reach the remote'
      return 0
    fi
  fi

  local counts
  counts=$(git -C "$ROOT" rev-list --left-right --count "HEAD...$GIT_UPSTREAM" 2>/dev/null) || {
    GIT_REASON='upstream ref is missing locally'
    return 0
  }
  GIT_AHEAD=$(awk '{print $1}' <<< "$counts")
  GIT_BEHIND=$(awk '{print $2}' <<< "$counts")
  if (( GIT_AHEAD > 0 && GIT_BEHIND > 0 )); then GIT_STATE=diverged
  elif (( GIT_BEHIND > 0 )); then GIT_STATE=behind
  elif (( GIT_AHEAD > 0 )); then GIT_STATE=ahead
  else GIT_STATE=current
  fi
}

update_available() { [[ "${GIT_STATE:-}" == behind || "${GIT_STATE:-}" == diverged ]]; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_install() {
  local explicit="" remember=$1 interactive=$2 build=1
  shift 2
  while (( $# )); do
    case "$1" in
      --agents) explicit=${2:-}; shift 2 ;;
      --agents=*) explicit=${1#*=}; shift ;;
      --no-build) build=0; shift ;;
      --yes|-y) interactive=noprompt; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for install: $1" ;;
    esac
  done

  local agents
  agents=$(resolve_agents "$explicit" "$remember" "$interactive")
  [[ -n "$agents" ]] || sx_die 'no agents selected'

  (( build )) && "$ROOT/bin/build.sh"

  local previous
  previous=$(recorded_checkout)
  if [[ -n "$previous" && "$previous" != "$ROOT" ]]; then
    echo "Checkout moved: $previous -> $ROOT (repairing managed links)"
  fi

  local entries mode
  entries="$SX_TMP/entries.tsv"
  mode=$(sync_agents "$agents" "$entries")
  prune_unmanaged "$entries"
  SX_LAST_INSTALL=$(sx_now)
  SX_LAST_SYNC=$SX_LAST_INSTALL
  record_manifest "$agents" "$mode" "$entries"

  echo "Installed skill-x for: $agents"
  echo "  installation  $SX_ID"
  echo "  checkout      $ROOT"
  echo "  state         $(sx_state_dir "$SX_ID")"
  echo "  opencode      $mode"
  echo
  print_invocation "$agents"
  echo
  echo 'Next:'
  echo '  bin/skill-x status     confirm the installation is current'
  echo '  bin/skill-x doctor     verify every managed path'
  echo '  bin/skill-x update     fetch and preview the next update'
  echo 'Restart each agent so it picks up the new skills.'
}

cmd_sync() {
  local explicit=""
  while (( $# )); do
    case "$1" in
      --agents) explicit=${2:-}; shift 2 ;;
      --agents=*) explicit=${1#*=}; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for sync: $1" ;;
    esac
  done

  local agents entries mode
  agents=$(resolve_agents "$explicit" remember noprompt)
  [[ -n "$agents" ]] || sx_die 'no agents selected'
  entries="$SX_TMP/entries.tsv"
  mode=$(sync_agents "$agents" "$entries")
  prune_unmanaged "$entries"
  SX_LAST_SYNC=$(sx_now)
  record_manifest "$agents" "$mode" "$entries"

  if [[ "$mode" == v1 ]] && sx_contains opencode $agents; then
    echo 'Skills synchronized (OpenCode v1 command shims installed).'
  else
    echo 'Skills synchronized (OpenCode v2 exposes skills natively; no command shims installed).'
  fi
}

cmd_status() {
  local json=0 fetch=fetch
  while (( $# )); do
    case "$1" in
      --json) json=1; shift ;;
      --no-fetch|--offline) fetch=nofetch; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for status: $1" ;;
    esac
  done

  local agents mode commit branch upstream recorded moved=0
  agents=$(manifest_agents)
  mode=$(sx_manifest_scalar "$MANIFEST" opencode_mode)
  [[ -n "$mode" ]] || mode=$(opencode_mode)
  commit=$(sx_git_commit "$ROOT")
  branch=$(sx_git_branch "$ROOT")
  recorded=$(recorded_checkout)
  [[ -n "$recorded" && "$recorded" != "$ROOT" ]] && moved=1

  compute_git_state "$fetch"
  upstream=$GIT_UPSTREAM

  local ok=0 missing=0 stale=0 foreign=0 state agent path detail
  local -a rows=()
  while IFS=$'\t' read -r state agent path detail; do
    [[ -n "$path" ]] || continue
    rows+=("$state"$'\t'"$agent"$'\t'"$path"$'\t'"$detail")
    case "$state" in
      ok) ok=$((ok + 1)) ;;
      missing) missing=$((missing + 1)) ;;
      stale) stale=$((stale + 1)) ;;
      foreign) foreign=$((foreign + 1)) ;;
    esac
  done < <(check_entries)

  if (( json )); then
    status_json "$agents" "$mode" "$commit" "$branch" "$recorded" "$moved" \
      "$ok" "$missing" "$stale" "$foreign" ${rows[@]+"${rows[@]}"}
    return 0
  fi

  if [[ ! -f "$MANIFEST" ]]; then
    echo 'skill-x is not installed from this checkout yet.'
    echo 'Run bin/skill-x init to select agents and install.'
    echo
  fi

  echo 'skill-x status'
  printf '  installation  %s\n' "$SX_ID"
  printf '  checkout      %s\n' "$ROOT"
  (( moved )) && printf '  moved from    %s (run bin/skill-x install to repair)\n' "$recorded"
  printf '  repository    %s\n' "$(sx_git_remote_url "$ROOT")"
  printf '  commit        %s%s\n' "${commit:0:12}" "${branch:+ ($branch)}"
  printf '  upstream      %s\n' "${upstream:-none}"
  printf '  state         %s%s\n' "$GIT_STATE" "${GIT_REASON:+ — $GIT_REASON}"
  if [[ "$GIT_STATE" != unreachable ]]; then
    printf '  behind/ahead  %s / %s\n' "$GIT_BEHIND" "$GIT_AHEAD"
  fi
  printf '  worktree      %s\n' "$( (( GIT_DIRTY )) && echo dirty || echo clean)"
  if update_available; then
    printf '  update        available (bin/skill-x update)\n'
  elif [[ "$GIT_STATE" == unreachable ]]; then
    printf '  update        unknown\n'
  else
    printf '  update        none\n'
  fi
  printf '  agents        %s\n' "${agents:-none selected}"
  local agent version
  for agent in ${agents:-}; do
    version=$(sx_agent_version_cached "$agent")
    printf '                %-9s %s\n' "$agent" "${version:-not detected}"
  done
  printf '  opencode      %s\n' "$mode"
  printf '  skills        %s\n' "$(sx_manifest_array "$MANIFEST" skills | tr '\n' ' ')"
  printf '  managed paths %s ok, %s missing, %s stale, %s foreign\n' "$ok" "$missing" "$stale" "$foreign"
  printf '  last install  %s\n' "$(sx_manifest_scalar "$MANIFEST" last_install)"
  printf '  last sync     %s\n' "$(sx_manifest_scalar "$MANIFEST" last_sync)"
  printf '  last update   %s\n' "$(sx_manifest_scalar "$MANIFEST" last_update)"

  if [[ -n "$agents" ]]; then
    echo
    print_invocation "$agents"
  fi
  if (( missing + stale + foreign > 0 )); then
    echo
    echo 'Some managed paths need attention; run bin/skill-x doctor for details.'
  fi
}

status_json() {
  local agents=$1 mode=$2 commit=$3 branch=$4 recorded=$5 moved=$6
  local ok=$7 missing=$8 stale=$9 foreign=${10}
  shift 10

  local -a agent_list=() skill_list=() versions=()
  local line agent
  read -r -a agent_list <<< "$agents"
  while IFS= read -r line; do [[ -n "$line" ]] && skill_list+=("$line"); done < <(sx_manifest_array "$MANIFEST" skills)
  for agent in "${SKILL_X_ALL_AGENTS[@]}"; do versions+=("$agent" "$(sx_agent_version_cached "$agent")"); done

  printf '{\n'
  printf '  "schema": %s,\n' "$SKILL_X_MANIFEST_SCHEMA"
  printf '  "installation_id": "%s",\n' "$(sx_json_escape "$SX_ID")"
  printf '  "checkout_path": "%s",\n' "$(sx_json_escape "$ROOT")"
  printf '  "recorded_checkout_path": "%s",\n' "$(sx_json_escape "$recorded")"
  printf '  "checkout_moved": %s,\n' "$(sx_json_bool "$moved")"
  printf '  "installed": %s,\n' "$(sx_json_bool "$([[ -f "$MANIFEST" ]] && echo 1 || echo 0)")"
  printf '  "repository_url": "%s",\n' "$(sx_json_escape "$(sx_git_remote_url "$ROOT")")"
  printf '  "commit": "%s",\n' "$(sx_json_escape "$commit")"
  printf '  "branch": "%s",\n' "$(sx_json_escape "$branch")"
  printf '  "upstream": "%s",\n' "$(sx_json_escape "$GIT_UPSTREAM")"
  printf '  "state": "%s",\n' "$GIT_STATE"
  printf '  "state_reason": "%s",\n' "$(sx_json_escape "$GIT_REASON")"
  printf '  "behind": %s,\n' "$GIT_BEHIND"
  printf '  "ahead": %s,\n' "$GIT_AHEAD"
  printf '  "dirty": %s,\n' "$(sx_json_bool "$GIT_DIRTY")"
  printf '  "update_available": %s,\n' "$(sx_json_bool "$(update_available && echo 1 || echo 0)")"
  printf '  "agents": %s,\n' "$(sx_json_array ${agent_list[@]+"${agent_list[@]}"})"
  printf '  "agent_versions": %s,\n' "$(sx_json_map "${versions[@]}")"
  printf '  "opencode_mode": "%s",\n' "$(sx_json_escape "$mode")"
  printf '  "skills": %s,\n' "$(sx_json_array ${skill_list[@]+"${skill_list[@]}"})"
  printf '  "paths": {"ok": %s, "missing": %s, "stale": %s, "foreign": %s},\n' \
    "$ok" "$missing" "$stale" "$foreign"
  printf '  "entries": [\n'
  local first=1 state path detail
  for line in "$@"; do
    IFS=$'\t' read -r state agent path detail <<< "$line"
    (( first )) || printf ',\n'
    printf '    {"agent": "%s", "kind": "symlink", "path": "%s", "target": "%s", "status": "%s"}' \
      "$(sx_json_escape "$agent")" "$(sx_json_escape "$path")" \
      "$(sx_json_escape "$detail")" "$state"
    first=0
  done
  (( first )) || printf '\n'
  printf '  ]\n'
  printf '}\n'
}

cmd_doctor() {
  local strict=0 json=0
  while (( $# )); do
    case "$1" in
      --strict) strict=1; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for doctor: $1" ;;
    esac
  done

  if (( json )); then
    cmd_status --json --no-fetch
  else
    doctor_text
  fi

  local broken
  broken=$(check_entries | grep -cvE '^ok' || true)
  if [[ ! -f "$MANIFEST" ]]; then
    (( strict )) && { echo 'skill-x: no installation manifest for this checkout' >&2; return 1; }
    return 0
  fi
  if (( strict )) && (( broken > 0 )); then
    printf 'skill-x: %s managed path(s) need attention\n' "$broken" >&2
    return 1
  fi
  return 0
}

doctor_text() {
  local mode agents recorded
  agents=$(manifest_agents)
  mode=$(sx_manifest_scalar "$MANIFEST" opencode_mode)
  [[ -n "$mode" ]] || mode=$(opencode_mode)
  recorded=$(recorded_checkout)

  echo 'Managed paths'
  if [[ ! -f "$MANIFEST" ]]; then
    echo '  NONE    no installation manifest; run bin/skill-x init'
  else
    if [[ -n "$recorded" && "$recorded" != "$ROOT" ]]; then
      printf '  MOVED   checkout recorded at %s but running from %s\n' "$recorded" "$ROOT"
      printf '          run bin/skill-x install to repoint every managed link\n'
    fi
    local state agent path detail
    while IFS=$'\t' read -r state agent path detail; do
      [[ -n "$path" ]] || continue
      case "$state" in
        ok) printf '  OK      %-9s %s -> %s\n' "$agent" "$path" "$detail" ;;
        missing) printf '  MISSING %-9s %s (run bin/skill-x install)\n' "$agent" "$path" ;;
        stale) printf '  STALE   %-9s %s -> %s (target is gone)\n' "$agent" "$path" "$detail" ;;
        foreign) printf '  FOREIGN %-9s %s (%s; left untouched)\n' "$agent" "$path" "$detail" ;;
      esac
    done < <(check_entries)
  fi

  local id orphan_path found=0
  while IFS=$'\t' read -r id orphan_path; do
    (( found )) || { echo; echo 'Other installations recorded in this HOME'; found=1; }
    printf '  ORPHAN  %s (checkout %s is gone)\n' "$id" "$orphan_path"
    printf '          remove it with SKILL_X_STATE_DIR=%s bin/skill-x uninstall --yes\n' \
      "$(sx_state_dir "$id")"
  done < <(orphaned_installations)

  cat <<EOF

Explicit invocation per agent
  Claude Code   /<skill>              automatic from ~/.claude/skills/<skill>/SKILL.md
  Codex         \$<skill> or /skills   automatic from ~/.agents/skills/<skill>/SKILL.md
                                      (deprecated custom prompts are not installed)
  OpenCode v1   /<skill>              requires a command shim in ~/.config/opencode/commands/
  OpenCode v2   /<skill>              native skill slash catalog; shims are intentionally absent

Selected agents: ${agents:-none}
Resolved OpenCode edition: $mode (override with SKILL_X_OPENCODE_VERSION=v1|v2)

Manual smoke test (one per agent, after restarting it):
1. Claude Code: run /x-discovery and confirm the skill body is loaded.
2. Codex: run \$x-discovery, then /skills, and confirm the skill is listed.
3. OpenCode: run /x-discovery. On v1 the shim must load the canonical skill
   through the skill tool; on v2 the entry must appear exactly once.
EOF
}

cmd_update() {
  local check_only=0 assume_yes=0
  while (( $# )); do
    case "$1" in
      --check) check_only=1; shift ;;
      --yes|-y) assume_yes=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for update: $1" ;;
    esac
  done

  sx_is_git_repo "$ROOT" || sx_die 'this checkout is not a git repository; updates are only available for git installations'
  compute_git_state fetch

  case "$GIT_STATE" in
    unreachable) sx_die "cannot determine the update state: ${GIT_REASON:-unknown}" ;;
    current)
      echo "Already up to date with $GIT_UPSTREAM ($(sx_git_commit "$ROOT" | cut -c1-12))."
      clear_update_throttle
      return 0
      ;;
    ahead)
      echo "This checkout is $GIT_AHEAD commit(s) ahead of $GIT_UPSTREAM and has nothing to pull."
      return 0
      ;;
  esac

  echo "Update available: $GIT_BEHIND commit(s) behind $GIT_UPSTREAM."
  preview_update

  if (( check_only )); then
    return 0
  fi
  if [[ "$GIT_STATE" == diverged ]]; then
    sx_die "refusing to update a diverged checkout ($GIT_AHEAD ahead, $GIT_BEHIND behind).
  Rebase or reset your local commits first:
    git -C $ROOT log --oneline $GIT_UPSTREAM..HEAD
    git -C $ROOT rebase $GIT_UPSTREAM"
  fi
  if (( GIT_DIRTY )); then
    sx_die "refusing to update a dirty checkout; deployed skills are unchanged.
  Commit or stash your local changes first:
    git -C $ROOT status --short"
  fi

  if (( ! assume_yes )); then
    if [[ -t 0 && -t 1 ]]; then
      local reply
      printf 'Apply this update? [y/N] '
      read -r reply || reply=""
      [[ "$reply" == [yY]* ]] || { echo 'Update declined; nothing changed.'; return 0; }
    else
      sx_die 'refusing to update without confirmation; re-run with --yes'
    fi
  fi

  git -C "$ROOT" merge --ff-only --quiet "$GIT_UPSTREAM"
  echo "Fast-forwarded to $(sx_git_commit "$ROOT" | cut -c1-12)."

  # Generated artifacts are disposable. Rebuild the updated canonical sources
  # before synchronizing any managed path.
  "$ROOT/bin/build.sh"

  local agents entries mode
  agents=$(resolve_agents '' remember noprompt)
  entries="$SX_TMP/entries.tsv"
  mode=$(sync_agents "$agents" "$entries")
  prune_unmanaged "$entries"
  SX_LAST_SYNC=$(sx_now)
  SX_LAST_UPDATE=$SX_LAST_SYNC
  record_manifest "$agents" "$mode" "$entries"
  clear_update_throttle

  echo
  cmd_doctor || true
}

preview_update() {
  local range="HEAD..$GIT_UPSTREAM" changed
  changed=$(git -C "$ROOT" diff --name-only "$range" -- commands-src 2>/dev/null |
    awk -F/ 'NF > 1 {print $2}' | sort -u | tr '\n' ' ')
  printf '  skills changed    %s\n' "${changed:-none}"
  changed=$(git -C "$ROOT" diff --name-only "$range" -- bin install.sh _shared 2>/dev/null |
    sort -u | tr '\n' ' ')
  printf '  installer changed %s\n' "${changed:-none}"
  echo '  commits'
  git -C "$ROOT" log --oneline --no-decorate "$range" 2>/dev/null | sed 's/^/    /'
}

clear_update_throttle() {
  local dir
  dir=$(sx_state_dir "$SX_ID")
  rm -f "$dir/last-check" "$dir/snooze-until"
}

# Return success when deleting the checkout would discard local content. Normal
# tracked/untracked changes always block. Ignored files also block unless they
# live under one of the registered disposable artifact roots produced by build.
checkout_has_local_content() {
  local root=$1 status path allowed skip entry
  status=$(git -C "$root" status --porcelain --untracked-files=all 2>/dev/null) || return 0
  [[ -n "$status" ]] && return 0

  local -a disposable=("$CANONICAL_DEST")
  for entry in "${TRANSFORMED_TARGETS[@]}"; do
    disposable+=("${entry##*:}")
  done

  while IFS= read -r -d '' path; do
    skip=0
    for allowed in "${disposable[@]}"; do
      allowed=${allowed%/}
      if [[ "$path" == "$allowed" || "$path" == "$allowed/"* ]]; then
        skip=1
        break
      fi
    done
    (( skip )) || return 0
  done < <(git -C "$root" ls-files --others --ignored --exclude-standard -z 2>/dev/null)
  return 1
}

cmd_uninstall() {
  local explicit="" remove_checkout=0 assume_yes=0
  while (( $# )); do
    case "$1" in
      --agents) explicit=${2:-}; shift 2 ;;
      --agents=*) explicit=${1#*=}; shift ;;
      --remove-checkout) remove_checkout=1; shift ;;
      --yes|-y) assume_yes=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) sx_die "unknown option for uninstall: $1" ;;
    esac
  done

  [[ -f "$MANIFEST" ]] || sx_die "no installation manifest at $MANIFEST; nothing recorded to remove"

  # Checked before anything is removed: a refusal here must leave the whole
  # installation intact, not a half-uninstalled one.
  if (( remove_checkout )) && checkout_has_local_content "$ROOT"; then
    sx_die "refusing to delete a dirty checkout at $ROOT
  Commit, stash or remove local content first (tracked, untracked, and non-generated ignored files count):
    git -C $ROOT status --short --ignored"
  fi

  local selected=""
  [[ -n "$explicit" ]] && selected=$(sx_parse_agents "$explicit")

  if (( ! assume_yes )) && [[ -t 0 && -t 1 ]]; then
    local reply
    printf 'Remove skill-x managed files for %s? [y/N] ' "${selected:-$(manifest_agents)}"
    read -r reply || reply=""
    [[ "$reply" == [yY]* ]] || { echo 'Uninstall declined; nothing changed.'; return 0; }
  fi

  local kept entries agent kind path target removed=0 preserved=0
  entries="$SX_TMP/entries.tsv"
  kept="$SX_TMP/kept.tsv"
  : > "$kept"
  sx_manifest_entries "$MANIFEST" > "$entries"

  while IFS=$'\t' read -r agent kind path target; do
    [[ -n "$path" ]] || continue
    if [[ -n "$selected" ]] && ! sx_contains "$agent" $selected; then
      printf '%s\t%s\t%s\t%s\n' "$agent" "$kind" "$path" "$target" >> "$kept"
      continue
    fi
    if [[ -L "$path" && "$(readlink "$path")" == "$target" ]]; then
      rm -f "$path"
      printf '  removed   %s\n' "$path"
      removed=$((removed + 1))
    elif [[ -e "$path" || -L "$path" ]]; then
      printf '  preserved %s (no longer managed by this installation)\n' "$path"
      preserved=$((preserved + 1))
    else
      printf '  gone      %s\n' "$path"
    fi
  done < "$entries"

  printf 'Removed %s managed path(s); preserved %s user-owned path(s).\n' "$removed" "$preserved"

  if [[ -s "$kept" ]]; then
    local mode agents
    mode=$(sx_manifest_scalar "$MANIFEST" opencode_mode)
    agents=$(manifest_agents)
    local remaining="" agent_name
    for agent_name in $agents; do
      sx_contains "$agent_name" $selected || remaining+="$agent_name "
    done
    SX_LAST_SYNC=$(sx_manifest_scalar "$MANIFEST" last_sync)
    record_manifest "${remaining% }" "$mode" "$kept"
    echo "Manifest kept for: ${remaining% }"
  else
    local dir
    dir=$(sx_state_dir "$SX_ID")
    rm -f "$MANIFEST" "$dir/last-check" "$dir/snooze-until"
    rmdir "$dir" 2>/dev/null || true
    echo "Removed installation state in $dir"
  fi

  if (( remove_checkout )); then
    echo "Removing checkout $ROOT"
    # exec so bash cannot try to read the rest of this script from a deleted file.
    cd /
    exec rm -rf -- "$ROOT"
  fi
  echo "Checkout kept at $ROOT (use --remove-checkout to delete it)."
}

# ---------------------------------------------------------------------------

main() {
  local cmd=${1:-help}
  (( $# )) && shift
  case "$cmd" in
    init) cmd_install fresh prompt "$@" ;;
    install) cmd_install remember noprompt "$@" ;;
    sync) cmd_sync "$@" ;;
    status) cmd_status "$@" ;;
    doctor) cmd_doctor "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; sx_die "unknown command: $cmd" ;;
  esac
}

main "$@"
