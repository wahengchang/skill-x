#!/usr/bin/env bash
# Stable public lifecycle entry point. Keep uninstall in the dedicated cleanup
# script so legacy deployments can be removed even when no manifest survives.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ${1:-} == uninstall ]]; then
  shift
  exec "$ROOT/uninstall.sh" "$@"
fi
exec "$ROOT/bin/skill-x-core" "$@"
