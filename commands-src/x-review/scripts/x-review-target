#!/usr/bin/env bash
set -euo pipefail

[[ $# -le 2 ]] || { echo "Usage: x-review-target [--commit <target>]" >&2; exit 2; }
worktree=$(git rev-parse --show-toplevel)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
repo_root=$(cd "$(dirname "$common_dir")" && pwd -P)

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 | awk '{print $NF}'
  else
    echo "No SHA-256 utility found; install sha256sum, shasum, or openssl" >&2
    return 127
  fi
}

fingerprint_tree() {
  printf 'tree %s\n' "$1" | sha256_stream
}

if [[ ${1:-} == --commit ]]; then
  [[ $# -eq 2 ]] || { echo "Usage: x-review-target --commit <target>" >&2; exit 2; }
  tree=$(git -C "$worktree" rev-parse --verify "$2^{tree}")
  fingerprint_tree "$tree"
  exit 0
fi
[[ $# -eq 0 ]] || { echo "Usage: x-review-target [--commit <target>]" >&2; exit 2; }

runtime="$repo_root/.dev-hub/runtime"
mkdir -p "$runtime"
temporary=$(mktemp -d "$runtime/x-review-index.XXXXXX")
trap 'rm -rf "$temporary"' EXIT
index="$temporary/index"
export GIT_INDEX_FILE="$index"
git -C "$worktree" read-tree HEAD
git -C "$worktree" rm -r --cached --ignore-unmatch -- \
  .dev-hub/active .dev-hub/runtime .dev-hub/worktrees >/dev/null 2>&1 || true
git -C "$worktree" add -A -- . \
  ':(exclude).dev-hub/active/**' \
  ':(exclude).dev-hub/runtime/**' \
  ':(exclude).dev-hub/worktrees/**'
tree=$(git -C "$worktree" write-tree)
fingerprint_tree "$tree"
