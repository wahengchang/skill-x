#!/usr/bin/env bash
set -euo pipefail

start=${1:-.}
common_dir=$(git -C "$start" rev-parse --path-format=absolute --git-common-dir)
repo_root=$(cd "$(dirname "$common_dir")" && pwd -P)

case ${2:---repo-root} in
  --repo-root) printf '%s\n' "$repo_root" ;;
  --dev-hub) printf '%s/.dev-hub\n' "$repo_root" ;;
  *) echo "Usage: x-paths [start] [--repo-root|--dev-hub]" >&2; exit 2 ;;
esac
